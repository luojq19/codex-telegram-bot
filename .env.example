# Telegram bot token from @BotFather.
TELEGRAM_BOT_TOKEN=123456789:replace_me

# Comma-separated Telegram chat IDs allowed to run Codex.
# Start the relay, send /id to your bot, then paste the returned chat_id here.
TELEGRAM_ALLOWED_CHAT_IDS=123456789

# Codex command. Use an absolute path if codex is not on PATH in non-interactive shells.
CODEX_BIN=codex

# Project directory where new Codex sessions should run.
CODEX_WORKDIR=/absolute/path/to/your/project

# Codex sandbox for new sessions: read-only, workspace-write, or danger-full-access.
# Use danger-full-access only on a machine/account you trust.
CODEX_SANDBOX=workspace-write

# Optional directory for relay state: Telegram update offset and chat-to-session bindings.
# Default: ~/.codex_telegram_bot
# CODEX_RELAY_STATE_DIR=/absolute/path/to/state

# Optional extra PATH prefix. Useful for nvm-managed codex/node installations.
# Example: CODEX_EXTRA_PATH=/home/you/.nvm/versions/node/v24.15.0/bin
# CODEX_EXTRA_PATH=

# Max runtime for one Codex subprocess.
CODEX_RELAY_TIMEOUT_SEC=3600
